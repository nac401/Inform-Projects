  <item nodeId="node-433">
    <command xml:space="preserve">tell charlie about jesus</command>
    <result xml:space="preserve">Before you can get out the first half of a sentence the room darkens to near pitch black.</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
