  <item nodeId="node-979">
    <command xml:space="preserve">ask charlie about mortality</command>
    <result xml:space="preserve">"Hello!" You say again.&#x000A;&#x000A;Charlie cocks their head to the side, brief concern flashing across their face. "Hello! Good to see you."&#x000A;&gt;</result>
