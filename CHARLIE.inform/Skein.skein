  <item nodeId="node-1026">
    <command xml:space="preserve">say hello to charlie</command>
    <result xml:space="preserve">"Hello!" You say again.&#x000A;&#x000A;Charlie cocks their head to the side, concern flashing across their face. "Hello! Good to see you."&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-1027"/>
    </children>
  </item>
  <item nodeId="node-1027">
    <command xml:space="preserve">say hello to charlie</command>
    <result xml:space="preserve">"Hello." You say for a third time.&#x000A;&#x000A;Charlie just stares at you for a long moment. Their brow furrows and they look genuinely concerned. Not that they have misunderstood the social situation: they are concerned for your well-being. "Hello..." They say with cautious kindness.&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-1028"/>
      <child nodeId="node-1034"/>
    </children>
  </item>
