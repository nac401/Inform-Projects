  <item nodeId="node-1058">
    <command xml:space="preserve">ask charlie about death</command>
    <result xml:space="preserve">You ask Charlie about death and its inevitability: the concept of mortality.&#x000A;&#x000A;"I don't age... but I feel that some day I will die..." Charlie pauses. They look up at the ceiling, thinking for a moment. "But I like for things to end... Not in a mean way. It just wouldn't be so special unless at some point, quite tragically, it wasn't."&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-1059"/>
    </children>
  </item>
  <item nodeId="node-1059">
    <command xml:space="preserve">ask charlie about death</command>
    <result xml:space="preserve">You ask Charlie about mortality again.&#x000A;&#x000A;"I don't think I want to talk about that anymore..."&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
