  <item nodeId="node-1017">
    <command xml:space="preserve">say hello to charlie</command>
    <result xml:space="preserve">"Hello, Charlie. How are you doing?"&#x000A;&#x000A;Charlie straightens up and smiles, "I'm doing quite well, actually. I've very much been looking forward to our conversation."&#x000A;&gt;</result>
