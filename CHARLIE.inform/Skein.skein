  <item nodeId="node-560">
    <command xml:space="preserve">tell brigh about containment</command>
    <result xml:space="preserve">You read off your notes about Containment. As you speak, Brigh takes notes. He nods a few times but otherwise is silent.&#x000A;&#x000A;&gt;</result>
