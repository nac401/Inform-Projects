  <item nodeId="node-1015">
    <command xml:space="preserve">say hello to charlie</command>
    <result xml:space="preserve">"Hello, Charlie."&#x000A;&#x000A;Charlie smiles warmly. "Hello! Good to see you again."&#x000A;&gt;</result>
