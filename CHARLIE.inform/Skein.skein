  <item nodeId="node-1217">
    <command xml:space="preserve">[enter]</command>
    <result xml:space="preserve">You squint, looking eastward towards the rising sun. At the vanishing point of the highway you see a growing plume of dust. Looks like your taxi is on the way.&#x000A;&#x000A;&#x000A;Please press SPACE to continue.</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
