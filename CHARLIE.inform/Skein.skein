  <item nodeId="node-783">
    <command xml:space="preserve">themself</command>
    <result xml:space="preserve">You tell Brigh about Charlie. You start to veer off rom your notes.&#x000A;&#x000A;Brigh sighs. "Remember: You are here to observe, not to socialize with the subject. We know that it is fascinating but it is also an unknown existential threat."&#x000A;&#x000A;You open your mouth to retort... but think better of it.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
