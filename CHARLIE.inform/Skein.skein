  <item nodeId="node-207">
    <command xml:space="preserve"> </command>
    <result xml:space="preserve">SUBJ: RE: Black Site Closure&#x000A;Arizona black site, shuttered due to exorbitant costs, the facility is set to be converted to a nuclear test site by--</result>
    <commentary xml:space="preserve"></commentary>
