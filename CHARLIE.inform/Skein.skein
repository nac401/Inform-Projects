  <item nodeId="node-476">
    <command xml:space="preserve">tell brigh about home</command>
    <result xml:space="preserve">You read off your notes on Home. As you drone on dispassionately, Brigh takes notes but gives no response otherwise.&#x000A;&#x000A;&gt;</result>
