  <item nodeId="node-372">
    <command xml:space="preserve">[enter]</command>
    <result xml:space="preserve">Because there aren't really "puzzles" in CHARLIE, instead of hints, here's a key to the requisite actions in the game.&#x000A;&#x000A;check notes - "check notes" or "check note on a specific note&#x000A;asking - "ask person about thing, idea, subject"&#x000A;telling - "tell person about thing, idea, subject"&#x000A;finish debrief - "finish" or "finish debrief"&#x000A;&#x000A;&#x000A;&#x000A;Please press SPACE to continue.</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-373"/>
    </children>
  </item>
