    <command xml:space="preserve">check notes</command>
    <result xml:space="preserve">You have taken notes on the subjects of doctor brigh, surveillance and computation.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
  </item>
