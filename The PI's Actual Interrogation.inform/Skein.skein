  <item nodeId="node-1244">
    <command xml:space="preserve">hello perry</command>
    <result xml:space="preserve">I only understood you as far as wanting to hello.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-1245"/>
    </children>
  </item>
  <item nodeId="node-1245">
    <command xml:space="preserve">greet perry</command>
    <result xml:space="preserve">You nod to Perry, giving a grunt that somewhat resembles "hello". Perry looks up at you, dumbfounded.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
  </item>
  <item nodeId="node-1243">
    <command xml:space="preserve">say hello</command>
    <result xml:space="preserve">(addressing Perry)&#x000A;You say hello to Perry.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
  </item>
  <item nodeId="node-1248">
    <command xml:space="preserve">say hello </command>
    <result xml:space="preserve">(addressing Perry)&#x000A;You nod to Perry, giving a grunt that somewhat resembles "hello". Perry looks up at you, dumbfounded.&#x000A;&#x000A;You say hello to Perry.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
  </item>
  <item nodeId="node-2295">
    <command xml:space="preserve">say hello to perry</command>
    <result xml:space="preserve">You nod to Perry, giving a grunt that somewhat resembles "hello". Perry looks up at you, dumbfounded.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-2296"/>
    </children>
  </item>
