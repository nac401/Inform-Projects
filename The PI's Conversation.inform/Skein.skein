  <item nodeId="node-283">
    <command xml:space="preserve">n</command>
    <result xml:space="preserve">Pub&#x000A;The pub is cramped but empty. You are the sole proprietor sitting at the bar though there are a few other patrons milling about in the booths.&#x000A;&#x000A;The barkeep polishes a stein and glowers.&#x000A;&#x000A;The Follower arrives from the south.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-284"/>
    </children>
  </item>
