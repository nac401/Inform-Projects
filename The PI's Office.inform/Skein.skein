    <changed>NO</changed>
    <children>
      <child nodeId="node-399"/>
    </children>
  </item>
  <item nodeId="node-399">
    <command xml:space="preserve">examine apple</command>
    <result xml:space="preserve">An apple. It is a captivating shade of red. Like blood or lipstick or an apple.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-400"/>
    </children>
  </item>
  <item nodeId="node-400">
    <command xml:space="preserve">eat apple</command>
    <result xml:space="preserve">You eat the apple. Not bad.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
  </item>
