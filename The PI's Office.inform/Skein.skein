  <item nodeId="node-405">
    <command xml:space="preserve">x bookshelf</command>
    <result xml:space="preserve">Roughly a dozen books are spaced out across the 5 shelves of the bookshelf. Upon closer inspection, one of them is a dictionary and three of them look to be motel bibles.&#x000A;&#x000A;In the bookshelf are a few books.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-406"/>
    </children>
  </item>
  <item nodeId="node-406">
    <command xml:space="preserve">x books</command>
    <result xml:space="preserve">You absentmindedly caress the spines of the dusty books, as people do when they see books. You notice that between two of the worn motel bibles there is an old key. Huh. What's that doing there?&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-407"/>
      <child nodeId="node-409"/>
    </children>
  </item>
