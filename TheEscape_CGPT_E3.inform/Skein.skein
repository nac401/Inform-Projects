    <command xml:space="preserve">[up]</command>
    <result xml:space="preserve">Introduction to A Day in the Dungeon&#x000A; &gt; Instructions for Play&#x000A;   Hint&#x000A;&#x000A;   Introduction to A Day in the Dungeon&#x000A; &gt; Instructions for Play&#x000A;   Hint</result>
    <commentary xml:space="preserve"></commentary>
