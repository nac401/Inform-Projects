        <bibliographic>
            <title>Runaway Heist</title>
            <author>Chatworth_G_Petey</author>
            <headline>A short pulp train-heist</headline>
            <genre>Fiction</genre>
            <firstpublished>2025</firstpublished>
            <description>You've stolen a mystical artifact from a speeding train. Now the train is out of control-and if you can't stop it, you'll never escape with your prize.</description>
