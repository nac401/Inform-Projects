  <item nodeId="node-191">
    <command xml:space="preserve">south</command>
    <result xml:space="preserve">Caboose&#x000A;The caboose rattles dangerously. You could leap from here-if only the train weren't moving so fast.&#x000A;&#x000A;&gt;</result>
